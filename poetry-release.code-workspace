{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    // This interpreter is created by the setup Task
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "editor.inlayHints.padding": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.testing.pytestEnabled": true,
    "editor.inlayHints.enabled": "off",
    "search.exclude": {
      "__pycache__/**": true,
      ".mypy_cache/**": true,
      "*__pycache__*": true
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
      "editor.formatOnType": true,
      "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "ruff.lint.args": ["--config=${workspaceFolder}/pyproject.toml"],
    "ruff.format.args": ["--config=${workspaceFolder}/pyproject.toml"],
    "workbench.tree.indent": 15,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.colorCustomizations": {
      "tree.indentGuidesStroke": "#05ef3c"
    },
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "python.analysis.autoFormatStrings": true,
    "window.title": "${folderPath}/ - ${activeEditorShort}",
    "editor.formatOnSave": true,
    "multiDiffEditor.experimental.enabled": true,
    "sonarlint.connectedMode.project": {
      "connectionId": "swift-nav",
      "projectKey": "swift-nav_skylark-fault-injector"
    },
    "python.envFile": "${workspaceFolder}/.venv/pyvenv.cfg",
    "mypy-type-checker.args": [
      "\"mypy-type-checker.args\" = [\"--config-file=./pyproject.toml\"]"
    ],
    "pylint.args": ["\"pylint.args\": [\"--rcfile=./pyproject.toml\"]"]
  },
  "extensions": {
    "recommendations": [
      "charliermarsh.ruff",
      "github.vscode-pull-request-github",
      "fabiospampinato.vscode-open-in-github",
      "eamodio.gitlens",
      "sonarsource.sonarlint-vscode",
      "benjamin-simmonds.pythoncpp-debug",
      "DavidAnson.vscode-markdownlint",
      "donjayamanne.python-environment-manager",
      "donjayamanne.python-extension-pack",
      "foxundermoon.shell-format",
      "GitHub.copilot",
      "GitHub.copilot-chat",
      "github.vscode-github-actions",
      "hbenl.vscode-test-explorer",
      "hediet.vscode-drawio",
      "KevinRose.vsc-python-indent",
      "ms-python.black-formatter",
      "ms-python.isort",
      "ms-python.mypy-type-checker",
      "ms-python.pylint",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-toolsai.jupyter",
      "ms-toolsai.jupyter-keymap",
      "ms-toolsai.jupyter-renderers",
      "ms-toolsai.vscode-jupyter-cell-tags",
      "ms-toolsai.vscode-jupyter-slideshow",
      "redhat.vscode-yaml"
    ]
  },
  "tasks": {
    "tasks": [],
    "version": "2.0.0"
  },
  "launch": {
    "configurations": [],
    "version": "2.0.0",
    "inputs": []
  }
}
